<?xml version="1.0" encoding="utf-8"?>
<!--
  ~ ABP Call — Ploshadki.kz fork of CallVault. GPL-3.0-or-later with the Section 7 terms in LICENSE.
  ~ Host switches: an app that embeds the recorder overrides these in its own resources.
  -->
<resources>
    <!-- Show the recorder's own icon on the home screen. A host app (CRM) sets false and opens the
         recorder screens through com.baba.callvault.ploshadki.RecorderEntry instead. -->
    <bool name="abp_show_launcher_icon">true</bool>
    <!-- Handle abpcall://enroll links (enrollment QR). A host that passes the link itself, e.g. through
         RecorderEntry.openServerConnection(context, link), sets false so only one app claims the scheme. -->
    <bool name="abp_enroll_deeplink_enabled">true</bool>
</resources>
